  dispatchId        String?                @map("dispatch_id") @db.Uuid
  goodsReceiptId    String?                @map("goods_receipt_id") @db.Uuid
  transferLineId    String?                @map("transfer_line_id") @db.Uuid
  adjustmentId      String?                @unique @map("adjustment_id") @db.Uuid
